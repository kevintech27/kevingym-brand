{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "redirects": [
    { "source": "/buy", "destination": "https://kevingymworkout.com/buy", "permanent": true },
    { "source": "/success", "destination": "https://kevingymworkout.com/success", "permanent": false },
    { "source": "/checkout-success", "destination": "https://kevingymworkout.com/checkout-success", "permanent": false },

    { "source": "/login", "destination": "https://kevingymworkout.com/login", "permanent": false },
    { "source": "/forgot-password", "destination": "https://kevingymworkout.com/forgot-password", "permanent": false },
    { "source": "/set-password", "destination": "https://kevingymworkout.com/set-password", "permanent": false },
    { "source": "/auth/:path*", "destination": "https://kevingymworkout.com/auth/:path*", "permanent": false },
    { "source": "/dashboard", "destination": "https://kevingymworkout.com/dashboard", "permanent": false },

    { "source": "/cgv", "destination": "https://kevingymworkout.com/cgv", "permanent": true },
    { "source": "/mentions-legales", "destination": "https://kevingymworkout.com/mentions-legales", "permanent": true },
    { "source": "/confidentialite", "destination": "https://kevingymworkout.com/confidentialite", "permanent": true }
  ],

  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
